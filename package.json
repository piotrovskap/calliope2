{
  "name": "das-tech-portal",
  "private": true,
  "description": "DAS CDP portal worker — static knowledge base + chat agent endpoint",
  "type": "module",
  "scripts": {
    "build": "npm run predeploy",
    "build:customers:css": "tailwindcss -i ./daisyui.css -o ./daisyui.generated.css --minify",
    "dev": "node scripts/dev-local.mjs",
    "predeploy": "npm run build:customers:css && make portal-site",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "daisyui": "^5.7.16"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.103.0"
  }
}
